{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropTheMeme",
  "version": "0.1.0",
  "identifier": "com.dropthememe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DropTheMeme",
        "width": 420,
        "height": 680,
        "resizable": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "DropTheMeme Overlay",
        "width": 300,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "x": 20,
        "y": 20,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "store": {}
  }
}
